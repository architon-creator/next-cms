# Copy this file to .env.local (gitignored) and fill in the two blanks
# below. admin-app's Next.js server reads env vars from ITS OWN root —
# packages/prismic-migration/.env is never read here, that file only
# matters when running prismic-migration's own CLI directly.

# Keep this to just the two environments you actually have configured —
# any name in the chain with no matching <NAME>_REPOSITORY below is shown
# greyed-out in the UI rather than erroring.
ENVIRONMENT_CHAIN=dev,sit

# --- dev ---
# Free Prismic plans only get ONE repository. If that's you, point BOTH
# dev and sit at that same repository name/token below, and only ever
# use dry run in the UI — a live (non-dry-run) run with from==to targets
# the same real repo and will try to create duplicate documents in it.
DEV_REPOSITORY=your-repo-name
# Write-scoped permanent token: npx prismic token create --write
DEV_MIGRATION_TOKEN=

# --- sit ---
SIT_REPOSITORY=your-repo-name
SIT_MIGRATION_TOKEN=
