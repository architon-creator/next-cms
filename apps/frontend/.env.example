NEXT_PUBLIC_PRISMIC_ENVIRONMENT=next-js-ssr

# Absolute base URL of this app, used for metadataBase, robots.txt, and
# sitemap.xml. Set to the real production domain in deployed environments.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OpenTelemetry (see instrumentation.ts / the "otel" package). Traces/logs
# are sent here — run `docker-compose up -d` at the repo root for a local
# Jaeger + otel-collector stack, then browse http://localhost:16686.
OTEL_SERVICE_NAME=next-cms-frontend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# Required only if the Prismic repository is private.
# Prismic dashboard -> Settings -> API & Security -> generate a read-only token.
PRISMIC_ACCESS_TOKEN=your-read-only-token

# Base URL of the Express API in apps/api, used server-side by the auth route
# handlers. Not NEXT_PUBLIC_ on purpose: the browser talks only to this app,
# which holds the session token in an httpOnly cookie and proxies to the API.
API_URL=http://localhost:4000
