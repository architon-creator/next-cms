NEXT_PUBLIC_PRISMIC_ENVIRONMENT=next-js-ssr

# Absolute base URL of this app, used for metadataBase, robots.txt, and
# sitemap.xml. Set to the real production domain in deployed environments.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OpenTelemetry (see instrumentation.ts / the "otel" package). Traces/logs
# are sent here — run `docker-compose up -d` at the repo root for a local
# Jaeger + otel-collector stack, then browse http://localhost:16686.
# Port 4318, not 4317: @vercel/otel's exporter only speaks OTLP/HTTP, and
# 4318 is the collector's HTTP receiver (4317 is its gRPC receiver — that's
# what apps/api's exporter uses instead).
OTEL_SERVICE_NAME=next-cms-frontend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Required only if the Prismic repository is private.
# Prismic dashboard -> Settings -> API & Security -> generate a read-only token.
PRISMIC_ACCESS_TOKEN=your-read-only-token

# Base URL of the Express API in apps/api, used server-side by the auth route
# handlers. Not NEXT_PUBLIC_ on purpose: the browser talks only to this app,
# which holds the session token in an httpOnly cookie and proxies to the API.
API_URL=http://localhost:4000

# Optional: send the product-form demo (POST /demo/products) to the Java API in
# apps/java-api (run "pnpm java:dev") instead of the Express API. Leave unset to
# keep using API_URL.
# PRODUCT_API_URL=http://localhost:4001

# --- Login with the identity provider (OIDC), see docs/ibe-login.md ----------
# Public URL of THIS app. Redirect URLs are built from it, never from the request
# (behind a load balancer the request shows the internal host).
# APP_BASE_URL=http://localhost:3000
# Issuer of the identity provider (discovery is read from <issuer>/.well-known/openid-configuration).
#   mock IdP (pnpm idp:mock):      http://localhost:9000
#   Keycloak (docker compose):     http://localhost:8081/realms/ibe
# OIDC_ISSUER=http://localhost:9000
# OIDC_CLIENT_ID=ibe-web
# In deployed environments this comes from a secrets manager, never from git.
# OIDC_CLIENT_SECRET=dev-secret
# Optional: a separate key for signing the temporary login cookie. If unset, the client secret is used.
# AUTH_COOKIE_SECRET=
# Must match exactly what is registered with the identity provider.
# OIDC_REDIRECT_URI=http://localhost:3000/auth/callback
# Add booking.read to call the Java endpoints that require that scope.
# OIDC_SCOPE=openid profile email booking.read
# Pin the ID token signing algorithm to what the provider uses (default RS256).
# OIDC_ID_TOKEN_ALG=RS256
# Session store. Required in production; if unset in development, sessions are
# kept in memory (lost on restart, not shared between instances).
# REDIS_URL=redis://localhost:6379
# SESSION_TTL_SECONDS=3600
# SESSION_MAX_AGE_SECONDS=28800
# Java API reached by the /api/ibe/* proxy (with the user's access token).
# JAVA_API_BASE_URL=http://localhost:4001
