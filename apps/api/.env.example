PORT=4000

# OpenTelemetry (see src/instrumentation.ts). Same collector as
# apps/frontend — run `pnpm run otel:up` at the repo root, then browse
# http://localhost:16686.
OTEL_SERVICE_NAME=next-cms-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Signs session tokens. Required in production — the app refuses to boot on
# its dev fallback there. Generate with: openssl rand -base64 32
JWT_SECRET=dev-only-insecure-secret
# Session lifetime in seconds (default 8 hours).
SESSION_TTL_SECONDS=28800

# Seeds the in-memory demo account. DEMO_USER_PASSWORD must be changed from
# its default before NODE_ENV=production, or startup fails.
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=password123
