# --- dev repository ---
DEV_REPOSITORY=your-dev-repo
# Read-only token, only needed if the dev repository is private.
DEV_ACCESS_TOKEN=
# Write-scoped permanent token (generate: npx prismic token create --write),
# used for the Migration/Asset/Custom Types APIs. Higher privilege than
# DEV_ACCESS_TOKEN — treat it as a secret, never log it, never let it reach
# data/mapping.json.
DEV_MIGRATION_TOKEN=

# --- sit repository ---
SIT_REPOSITORY=your-sit-repo
SIT_ACCESS_TOKEN=
SIT_MIGRATION_TOKEN=

# --- local paths (all optional, these are the defaults) ---
MAPPING_DIR=./data
SNAPSHOT_DIR=./snapshots
REPORT_DIR=./reports
CACHE_DIR=./.cache
