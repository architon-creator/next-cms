# The full promotion chain, lowest to highest — every pairwise command
# (migrate/preflight/assets/backsync/reconcile/link/unlink/retitle/
# confirm/verify/inspect) requires --from/--to to name two ADJACENT
# entries here. Optional; this is the default if unset.
ENVIRONMENT_CHAIN=dev,sit,uat,prod

# Only configure the environments you actually use right now — an
# environment with no <NAME>_REPOSITORY set is simply skipped, no error,
# unless a command's --from/--to actually references it.

# --- dev ---
DEV_REPOSITORY=your-dev-repo
# Read-only token, only needed if the repository is private.
DEV_ACCESS_TOKEN=
# Write-scoped permanent token (generate: npx prismic token create --write),
# used for the Migration/Asset/Custom Types APIs. Higher privilege than
# DEV_ACCESS_TOKEN — treat it as a secret, never log it, never let it reach
# a mapping file.
DEV_MIGRATION_TOKEN=

# --- sit ---
SIT_REPOSITORY=your-sit-repo
SIT_ACCESS_TOKEN=
SIT_MIGRATION_TOKEN=

# --- uat ---
UAT_REPOSITORY=
UAT_ACCESS_TOKEN=
UAT_MIGRATION_TOKEN=

# --- prod ---
PROD_REPOSITORY=
PROD_ACCESS_TOKEN=
PROD_MIGRATION_TOKEN=

# --- local paths (all optional, these are the defaults) ---
MAPPING_DIR=./data
SNAPSHOT_DIR=./snapshots
REPORT_DIR=./reports
CACHE_DIR=./.cache
