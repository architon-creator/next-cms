{
  "name": "@architon-creator/ui",
  "version": "0.1.0",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "publishConfig": {
    "access": "restricted",
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.mjs",
        "require": "./dist/index.js"
      }
    },
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "react": "^19.3.0"
  },
  "dependencies": {
    "@prismicio/next": "^2.3.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "lucide-react": "^1.42.0",
    "radix-ui": "^1.6.7"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "tsup": "^9.0.0",
    "typescript": "^5.5.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/architon-creator/ui.git"
  }
}
