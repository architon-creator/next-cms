{
  "description": "Heading + body text block, optionally with inline links",
  "id": "rich_text_section",
  "name": "RichTextSection",
  "type": "SharedSlice",
  "variations": [
    {
      "description": "Heading and body text",
      "docURL": "https://prismic.io/docs/slices",
      "id": "default",
      "imageUrl": "",
      "items": {
        "text": {
          "config": {
            "label": "Line Text",
            "placeholder": "",
            "single": "paragraph,strong,em,hyperlink"
          },
          "type": "StructuredText"
        },
        "font_size": {
          "config": {
            "default_value": "Medium",
            "label": "Font Size",
            "options": [
              "Small",
              "Medium",
              "Large"
            ],
            "placeholder": ""
          },
          "type": "Select"
        },
        "font_color": {
          "config": {
            "default_value": "Default",
            "label": "Font Color",
            "options": [
              "Default",
              "Muted",
              "Accent"
            ],
            "placeholder": ""
          },
          "type": "Select"
        }
      },
      "name": "Default",
      "primary": {
        "heading": {
          "config": {
            "label": "Heading",
            "labels": [
              "underline",
              "highlight"
            ],
            "placeholder": "",
            "single": "heading2,heading3"
          },
          "type": "StructuredText"
        },
        "body": {
          "config": {
            "label": "Body",
            "labels": [
              "small",
              "large",
              "muted",
              "accent",
              "highlight"
            ],
            "multi": "paragraph,strong,em,hyperlink,list-item,o-list-item",
            "placeholder": ""
          },
          "type": "StructuredText"
        },
        "font_size": {
          "config": {
            "default_value": "Medium",
            "label": "Font Size",
            "options": [
              "Small",
              "Medium",
              "Large"
            ],
            "placeholder": ""
          },
          "type": "Select"
        },
        "font_color": {
          "config": {
            "default_value": "Default",
            "label": "Font Color",
            "options": [
              "Default",
              "Muted",
              "Accent"
            ],
            "placeholder": ""
          },
          "type": "Select"
        }
      },
      "version": "initial"
    }
  ]
}